# =================================================================
# JK-BMS PROJECT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your credentials.
# =================================================================

# ── Wi-Fi Configuration (for ESP32 Gateway) ──────────────────────
WIFI_SSID=Your_WiFi_SSID
WIFI_PASSWORD=Your_WiFi_Password

# ── Target JK-BMS Hardware ───────────────────────────────────────
TARGET_SERIAL=507268D28101263
TARGET_NAME=507268D28101263

# ── MQTT Broker Configuration ────────────────────────────────────
MQTT_SERVER=broker.emqx.io
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=jkbms/507268D28101263/telemetry

# ── Server & Database Configuration ──────────────────────────────
# Default storage is SQLite at data/jkbms.db.
# If you wish to use an external PostgreSQL database, set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3000
DB_PATH=data/jkbms.db
PUBLIC_DIR=public

# ── Security (Optional) ──────────────────────────────────────────
# Protect manual HTTP ingestion at POST /api/telemetry (leave blank to disable)
API_KEY=
