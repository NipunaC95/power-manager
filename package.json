{
  "name": "jkbms-cloud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "env:sync": "node scripts/sync_env.js",
    "dev": "npm run build:standalone && npm run start",
    "typecheck": "tsc --noEmit && cd frontend && npm run typecheck",
    "build:frontend": "cd frontend && npm install --silent && node build.js",
    "build:bridge": "esbuild scripts/mqtt_bridge.ts --bundle --platform=node --target=node18 --outfile=dist/mqtt_bridge.js",
    "start:bridge": "npm run env:sync && npm run build:bridge && node dist/mqtt_bridge.js",
    "build:server": "esbuild server/src/server.ts --bundle --platform=node --target=node18 --external:better-sqlite3 --external:pg --outfile=dist/server.js",
    "build:standalone": "npm run build:frontend && npm run build:server",
    "build": "npm run build:standalone",
    "start:server": "node dist/server.js",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  }
}
